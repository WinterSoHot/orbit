+import { invoke, isTauri } from '@tauri-apps/api/core';
+import { listen } from '@tauri-apps/api/event';
+import { recoverTasks } from './model';
+import type { Task } from './model';
+
+export const desktop = isTauri();
+const STORAGE_KEY='orbit-demo-v1';
+export interface Doctor { available: boolean; initialized: boolean; path: string; version: string; message: string }
+
+export async function loadTasks(): Promise<{tasks:Task[];error:string|null}> {
+  if(desktop) return invoke('load_workspace');
+  const raw=localStorage.getItem(STORAGE_KEY);
+  if(!raw) return {tasks:[],error:null};
+  try {
+    const tasks=JSON.parse(raw);
+    if(!Array.isArray(tasks) || tasks.length>50 || tasks.some(t=>!t || t.provider!=='demo' || typeof t.id!=='string' || typeof t.title!=='string' || !Array.isArray(t.nodes) || !Array.isArray(t.events) || !Array.isArray(t.approvals) || !Array.isArray(t.artifacts))) throw new Error('invalid snapshot');
+    return {tasks:recoverTasks(tasks),error:null};
+  } catch { return {tasks:[],error:'本地演示记录无法读取，原记录已保留。当前展示临时演示数据。'}; }
+}
+export async function saveDemo(tasks: Task[]) {
+  const demo=tasks.filter(t=>t.provider==='demo').slice(0,50);
+  if(desktop) await invoke('save_demo',{tasks:demo});
+  else localStorage.setItem(STORAGE_KEY,JSON.stringify(demo));
+}
+export async function watchRuntime(callback:(task:Task)=>void,onWarning:(message:string)=>void) {
+  if(!desktop)return ()=>{};
+  const releaseTask=await listen<Task>('runtime-task',event=>callback(event.payload));
+  const releaseWarning=await listen<string>('runtime-warning',event=>onWarning(event.payload));
+  return ()=>{releaseTask();releaseWarning();};
+}
+export const checkCli=()=>invoke<Doctor>('doctor');
+export const exportArtifact=(artifactId:string)=>invoke<string>('export_artifact',{artifactId});
+export const createReal=(title:string,prompt:string,scene:string)=>invoke<Task>('create_task',{title,prompt,scene});
+export const startReal=(task:Task)=>invoke<Task>('start_run',{taskId:task.id});
+export const steerReal=(runId:string,text:string)=>invoke('steer_run',{runId,text});
+export const cancelReal=(runId:string)=>invoke('interrupt_run',{runId});
+export const replyReal=(runId:string,approvalId:string,answers:Record<string,string>)=>invoke('reply_input',{runId,approvalId,answers});
