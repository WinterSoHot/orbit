+                return Err("当前已有真实任务运行，请先结束或中断它".into());
+            }
+            let _ = r.child.stop();
+            if !r.idle() {
+                return Err("旧执行器清理未确认，请核对本机进程后重启工作台".into());
+            }
+        }
+        Ok(())
+    }
