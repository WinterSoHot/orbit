+  }
+  return next;
+}
+
+export function recoverTasks(tasks: Task[]): Task[] {
+  return tasks.map(task=>isActive(task.status)?{...task,status:'unknown',approvals:[],nodes:task.nodes.map(n=>isActive(n.status)?{...n,status:'unknown'}:n)}:task);
+}
+
