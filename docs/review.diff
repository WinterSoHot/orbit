+            r.task.event(message, "error", "工作台");
+            if r.child.stop().is_err() {
+                r.task.event(
+                    "拥有的进程组清理未确认；暂停新任务，请核对本机执行器",
+                    "error",
+                    "工作台",
+                );
+            }
+            r.task.clone()
+        };
+        self.publish(app, snapshot);
+    }
+    fn receive(
