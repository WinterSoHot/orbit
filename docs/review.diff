+export type Status = 'queued' | 'running' | 'approval' | 'cancelling' | 'interrupted' | 'completed' | 'failed' | 'unknown';
+export type Scene = 'research' | 'coding' | 'writing';
+export type Provider = 'demo' | 'codex';
+export interface AgentNode { id: string; name: string; role: string; model: string; status: Status; summary: string; output: string; parentId: string | null }
+export interface Activity { id: string; at: number; kind: string; agent: string; text: string }
+export interface Approval { id: string; requestId: string; runId: string; turnId: string; title: string; description: string; kind: string; questionIds: string[] }
+export interface Artifact { id: string; name: string; kind: string; content: string; createdAt: number }
+export interface Task { id: string; title: string; prompt: string; scene: Scene; provider: Provider; status: Status; createdAt: number; startedAt: number | null; finishedAt: number | null; runId: string | null; threadId: string | null; turnId: string | null; revision: number; phase: number; nodes: AgentNode[]; events: Activity[]; approvals: Approval[]; artifacts: Artifact[]; tokens: number | null }
+export type Action = { type: 'start' | 'tick' | 'cancel' } | { type: 'approve' | 'decline'; id: string } | { type: 'steer'; text: string };
+
+export const statusLabels: Record<Status, string> = { queued: '待启动', running: '运行中', approval: '等待你', cancelling: '中断请求中', interrupted: '已中断', completed: '执行结束', failed: '失败', unknown: '需核对' };
+export const sceneLabels: Record<Scene, string> = { research: '调研', coding: '编程', writing: '写作' };
+export const isActive = (status: Status) => ['running', 'approval', 'cancelling'].includes(status);
+export const isTerminal = (status: Status) => ['completed', 'failed', 'interrupted'].includes(status);
+
+function log(task: Task, text: string, now: number, agent = '工作台', kind = 'system'): Task {
+  return { ...task, revision: task.revision + 1, events: [...task.events, { id: `${task.id}-${task.revision}-${now}`, at: now, kind, agent, text }].slice(-100) };
+}
+
+function demoNodes(): AgentNode[] {
+  return [
+    {id:'lead', name:'Coordinator', role:'主 Agent', model:'演示 · 协调', status:'running', summary:'拆解目标，协调交付', output:'将任务拆成探索、分析与复核三个步骤。等待各阶段结果，汇总成可验收的交付。', parentId:null},
+    {id:'scout',name:'Scout',role:'探索者',model:'演示 · 探索',status:'queued',summary:'查找资料与上下文',output:'',parentId:'lead'},
+    {id:'analyst',name:'Analyst',role:'研究者',model:'演示 · 分析',status:'queued',summary:'对比方案，形成结论',output:'',parentId:'lead'},
+    {id:'reviewer',name:'Reviewer',role:'审查者',model:'演示 · 复核',status:'queued',summary:'核对证据与边界',output:'',parentId:'lead'},
+  ];
+}
+
+export function makeTask(title: string, prompt: string, scene: Scene, provider: Provider, now = Date.now()): Task {
+  return { id: crypto.randomUUID(), title: title.trim(), prompt: prompt.trim(), scene, provider, status:'queued', createdAt:now, startedAt:null, finishedAt:null, runId:null, threadId:null, turnId:null, revision:0, phase:0, nodes:provider==='demo'?demoNodes().map(n=>({...n,status:'queued'})):[], events:[], approvals:[], artifacts:[], tokens:null };
+}
+
+function delivery(task: Task): Artifact {
+  const bodies: Record<Scene,string> = {
+    research: `# ${task.title}\n\n这是演示模式生成的示例交付，不是实际检索结果。\n\n## 建议方案\n\n选择本地桌面架构，使用 Tauri 管理窗口和进程，任务内部协作由执行器负责。优先跑通真实状态、审批与交付。\n\n## 复核意见\n\n- 将任务与运行尝试分开记录。\n- 断线后先核对状态，不自动重复工具调用。\n- 中断请求不能等同于所有外部副作用已撤销。\n\n## 下一步\n\n用一个调研任务和一个编程任务验证完整闭环。\n\n任务目标：${task.prompt}`,
+    coding: `# ${task.title}\n\n演示交付 · 没有实际修改仓库。\n\n## 变更建议\n\n把任务状态归到单一执行器，界面只消费状态投影；审批使用运行 ID 与请求 ID 关联。\n\n## 验证范围\n\n重复点击、取消与结束同时发生、重启后的过期审批。\n\n任务目标：${task.prompt}`,
+    writing: `# ${task.title}\n\n演示交付 · 文档草稿\n\n把注意力留给真正需要判断的地方。\n\n在一个工作台里发起任务，看见 Agent 如何协作，在必要时补充信息，最后收取清晰、可检查的成果。\n\n## 产品主张\n\n让多个任务持续推进，让每一次介入都有上下文，让每一份交付都有去处。\n\n任务目标：${task.prompt}`,
+  };
+  return {id:`${task.id}-delivery`,name:task.scene==='research'?'方案调研与可行性.md':task.scene==='coding'?'变更建议与验证.md':'产品介绍草稿.md',kind:'markdown',content:bodies[task.scene],createdAt:Date.now()};
+}
+
+export function reduceTask(task: Task, action: Action, now = Date.now()): Task {
+  if(task.provider!=='demo') return task;
+  if(action.type==='start' && !isActive(task.status)) {
+    return log({...task,status:'running',startedAt:now,finishedAt:null,runId:`${task.id}-${now}`,turnId:`turn-${now}`,phase:0,nodes:demoNodes(),approvals:[],artifacts:[],tokens:null},'已启动演示任务，不调用模型',now);
+  }
+  if(isTerminal(task.status)) return task;
+  if(action.type==='cancel' && isActive(task.status)) return log({...task,status:'interrupted',finishedAt:now,approvals:[],nodes:task.nodes.map(n=>n.status==='completed'?n:{...n,status:'interrupted'})},'演示任务已中断',now);
+  if(action.type==='steer' && isActive(task.status) && action.text.trim()) return log(task,`补充方向：${action.text.trim().slice(0,2000)}`,now,'你','input');
+  if(action.type==='approve' || action.type==='decline') {
+    const request=task.approvals.find(a=>a.id===action.id && a.runId===task.runId && a.turnId===task.turnId && a.requestId===action.id);
+    if(task.status!=='approval' || !request) return task;
+    if(action.type==='decline') return log({...task,status:'interrupted',finishedAt:now,approvals:[],nodes:task.nodes.map(n=>n.status==='completed'?n:{...n,status:'interrupted'})},'你拒绝了继续执行，演示已停止',now,'你','approval');
+    return log({...task,status:'running',approvals:[],nodes:task.nodes.map(n=>n.status==='approval'?{...n,status:'running'}:n)},'已确认：按个人桌面场景继续',now,'你','approval');
+  }
+  if(action.type!=='tick' || task.status!=='running') return task;
+  const phase=task.phase+1;
+  let next={...task,phase};
+  const change=(id:string,status:Status,summary:string,output:string)=>{ next={...next,nodes:next.nodes.map(n=>n.id===id?{...n,status,summary,output}:n)}; };
+  if(phase===1) {
+    change('scout','running','正在收集相关上下文','检索相关资料，整理候选方案与信息缺口。');
+    return log(next,'已委派 Scout 收集上下文',now,'Coordinator','agent');
+  }
+  if(phase===2) {
+    change('scout','completed','上下文已整理','找到三条候选技术路线，已整理各自的接入方式、能力与限制。演示数据未进行真实检索。');
+    change('analyst','running','正在对比候选方案','从交互、进程管理与恢复成本三个角度对比方案。');
+    return log(next,'Scout 返回资料摘要，Analyst 开始分析',now,'Analyst','agent');
+  }
+  if(phase===3) {
+    change('analyst','approval','需要确认交付范围','个人桌面与团队协作的权限、同步和分发成本差异较大。建议本次聚焦个人桌面。');
+    const id=`${task.runId}-scope`;
+    return log({...next,status:'approval',approvals:[{id,requestId:id,runId:task.runId!,turnId:task.turnId!,title:'确认本次交付范围',description:'建议先聚焦个人桌面工作台，将团队同步与云端运行留到后续。是否按这个范围继续？',kind:'input',questionIds:[]}]},'需要你确认范围，任务已等待',now,'Analyst','approval');
+  }
+  if(phase===4) {
+    change('analyst','completed','对比与结论已完成','建议先实现本地任务、执行记录、审批与交付；由原生 Agent 运行器负责内部协作。');
+    change('reviewer','running','正在核对边界','复核状态、审批过期与中断语义；检查是否把未知状态误报为成功。');
+    return log(next,'分析已完成，Reviewer 开始复核',now,'Reviewer','agent');
+  }
+  if(phase>=5) {
+    next={...next,status:'completed',finishedAt:now,nodes:next.nodes.map(n=>({...n,status:'completed',summary:n.id==='reviewer'?'复核完成 · 边界已记录':n.id==='lead'?'已汇总交付，等待验收':n.summary,output:n.id==='reviewer'?'复核意见：重启需要核对状态；审批不可跨运行复用；真实取消需等待执行器确认。':n.output})),artifacts:[delivery(task)]};
