+
+    #[tauri::command]
+    fn load_workspace(runtime: State<Runtime>) -> Workspace {
+        runtime.store.workspace()
+    }
+    #[tauri::command]
+    fn save_demo(runtime: State<Runtime>, tasks: Vec<Task>) -> Result<(), String> {
+        runtime.store.save_demo(tasks)
+    }
