+export function mergeDemoSnapshots(incoming: Task[], stored: Task[]): Task[] {
+  return incoming.map(task=>{const old=stored.find(t=>t.id===task.id);return old&&old.revision>=task.revision?old:task;});
+}
+
+export function editDocument(task:Task,id:string,expected:string,content:string):Task {
+  if(task.provider!=='demo'||!isTerminal(task.status))throw new Error('请等任务结束后再编辑交付物');
+  if(new TextEncoder().encode(content).length>256000)throw new Error('文档超过 256 KB，请缩短后保存');
+  const matches=task.artifacts.filter(a=>a.id===id);
+  if(matches.length!==1)throw new Error('文档不存在或标识重复，请重新打开');
+  if(matches[0].content!==expected)throw new Error('文档已更新，请保留草稿并重新打开');
+  if(content===expected)return task;
+  return log({...task,artifacts:task.artifacts.map(a=>a.id===id?{...a,content}:a)},'已保存 Markdown 修改',Date.now(),'你','artifact');
+}
