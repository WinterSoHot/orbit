+}
+* { box-sizing: border-box; }
+body { margin: 0; }
+button, input, textarea { font: inherit; }
+button { cursor: pointer; border: 0; background: none; color: inherit; transition: background-color .15s, border-color .15s; }
+button:disabled { cursor: not-allowed; opacity: .5; }
+:where(button, a, input, textarea):focus-visible { outline: 3px solid #007aff80; outline-offset: 3px; }
+button, a, input, textarea { -webkit-tap-highlight-color: transparent; }
+p, h1, h2, h3 { margin: 0; }
+svg { flex-shrink: 0; }
+input, textarea { color: var(--ink); }
