+        let selected = match selected {
+            Some(path) => {
+                if !path.is_absolute() {
+                    return Err("请选择绝对路径的文件夹".into());
+                }
+                let path = path
+                    .canonicalize()
+                    .map_err(|_| "所选文件夹不存在或无法访问")?;
