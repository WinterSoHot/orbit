{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit",
  "version": "0.1.1",
  "identifier": "local.orbit.agent-workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "title": "Orbit · Agent 工作台",
        "width": 1480,
        "height": 960,
        "minWidth": 1060,
        "minHeight": 720,
        "backgroundColor": "#F6F7F9"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; worker-src 'self' blob:; font-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "个人 Agent 工作台",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
